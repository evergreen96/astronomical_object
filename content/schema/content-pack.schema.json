{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/evergreen96/astronomical_object/main/content/schema/content-pack.schema.json",
  "title": "StarSky editorial content pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "publishedAt", "cards"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "cards": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/card" }
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "enum": ["western_zodiac", "zodiac_sign", "monthly_sky", "sky_event", "korean_sky", "russian_folk_sky"] },
        "objectIds": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 80 }
        },
        "focusKind": { "enum": ["", "Star", "Constellation", "Planet", "SunMoon", "Dso"] },
        "targets": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/target" }
        },
        "eyebrowKo": { "type": "string" },
        "eyebrowEn": { "type": "string" },
        "eyebrowRu": { "type": "string" },
        "titleKo": { "type": "string", "maxLength": 180 },
        "titleEn": { "type": "string", "maxLength": 180 },
        "titleRu": { "type": "string", "maxLength": 180 },
        "bodyKo": { "type": "string", "maxLength": 8000 },
        "bodyEn": { "type": "string", "maxLength": 8000 },
        "bodyRu": { "type": "string", "maxLength": 8000 },
        "activeMonths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 }
        },
        "activeFromMonthDay": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "activeUntilMonthDay": { "type": "string", "pattern": "^(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "previewFrom": { "type": "string", "format": "date" },
        "activeFrom": { "type": "string", "format": "date" },
        "activeUntil": { "type": "string", "format": "date" },
        "image": { "$ref": "#/$defs/image" },
        "sources": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "format": "uri", "pattern": "^https://" }
        },
        "priority": { "type": "integer" },
        "enabled": { "type": "boolean" }
      },
      "anyOf": [
        { "required": ["titleKo", "bodyKo"] },
        { "required": ["titleEn", "bodyEn"] }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objectId", "focusKind"],
      "properties": {
        "objectId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "focusKind": { "enum": ["Star", "Constellation", "Planet", "SunMoon", "Dso"] },
        "labelKo": { "type": "string", "maxLength": 180 },
        "labelEn": { "type": "string", "maxLength": 180 },
        "labelRu": { "type": "string", "maxLength": 180 }
      },
      "anyOf": [
        { "required": ["labelKo"] },
        { "required": ["labelEn"] }
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "source", "license"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://raw\\.githubusercontent\\.com/"
        },
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "credit": { "type": "string" }
      }
    }
  }
}
